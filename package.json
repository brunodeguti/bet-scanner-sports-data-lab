{
  "name": "bet-scanner-mvp",
  "version": "1.13.1",
  "private": true,
  "description": "Demonstra\u00e7\u00e3o offline de an\u00e1lise esportiva, importa\u00e7\u00e3o CSV e simula\u00e7\u00f5es matem\u00e1ticas",
